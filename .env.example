# ============================================================================
# SUPABASE & VERCEL ENVIRONMENT CONFIGURATION
# Replace these values with your actual Supabase project credentials
# ============================================================================

# Supabase API URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon API Key (Found in Supabase Dashboard -> Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-actual-supabase-anon-key-here
